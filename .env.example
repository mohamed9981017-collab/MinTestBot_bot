# Telegram bot credentials (required)
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Feeds to poll: comma or newline separated URLs (or use RSS_FEEDS_FILE)
RSS_FEEDS=https://remoteok.com/remote-dev-jobs.rss,https://weworkremotely.com/categories/remote-programming-jobs.rss
# RSS_FEEDS_FILE=feeds.txt

# Keyword filters (comma separated). Empty JOB_KEYWORDS keeps every entry.
JOB_KEYWORDS=python,backend,remote
EXCLUDE_KEYWORDS=senior,10+ years

# Runtime
POLL_INTERVAL=900
MAX_ITEMS_PER_RUN=20
REQUEST_TIMEOUT=20
STATE_FILE=seen_jobs.json
DRY_RUN=false
